<?xml version="1.0"?>
<package format="2">
  <name>engineer_planning_adapters</name>
  <version>0.0.0</version>
  <description>Custom MoveIt request adapters</description>
  <maintainer email="ch@todo.todo">ch</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>moveit_core</build_depend>
  <build_depend>moveit_ros_planning</build_depend>
  <build_depend>pluginlib</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>moveit_core</exec_depend>
  <exec_depend>moveit_ros_planning</exec_depend>
  <exec_depend>pluginlib</exec_depend>

  <export>
    <moveit_core plugin="${prefix}/planning_adapter_plugins.xml"/>
  </export>
</package>
